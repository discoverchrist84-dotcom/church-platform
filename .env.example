# Copy to .env and edit.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite for a quick start.
DATABASE_URL=postgres://church:church@localhost:5432/church
REDIS_URL=redis://localhost:6379/0

# Payments: dummy (dev only) | stripe (not implemented yet)
PAYMENT_PROVIDER=dummy

# S3-compatible storage (leave empty to store uploads on local disk)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Security / rate limits (defaults are fine for most churches) ---
RATE_LIMIT_PER_MIN=240            # per visitor IP, all pages
RATE_LIMIT_SENSITIVE_PER_MIN=12   # login, sign-up and giving submissions
LOGIN_MAX_FAILURES=6              # wrong passwords before a 15-minute block
# Set to True only behind Nginx/a load balancer that you control (so real visitor IPs are used):
TRUST_PROXY_HEADERS=False
# Production only: https://your-domain.org
CSRF_TRUSTED_ORIGINS=

# Bookshop: flat delivery fee per order that has printed books (same currency as DEFAULT_CURRENCY)
BOOKSTORE_SHIPPING_FEE=0
